# Copy to deployment/.env on the VPS and set the host Postgres login.
# Containers reach the VPS database as host.docker.internal:5432 (the docker bridge).
# Postgres must accept that path: listen_addresses cannot be only 127.0.0.1, and
# pg_hba.conf must allow the docker subnet (often 172.16.0.0/12) to this database.
# Do not add a Postgres container.

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=executv
POSTGRES_PASSWORD=executv
POSTGRES_DB=executv

DATABASE_URL=postgresql+psycopg2://executv:executv@host.docker.internal:5432/executv
ASYNC_DATABASE_URL=postgresql+asyncpg://executv:executv@host.docker.internal:5432/executv
SQL_ECHO=false

CORE_ENGINE_HOST=0.0.0.0
CORE_ENGINE_PORT=8001
CORE_ENGINE_URL=http://core_engine:8001

INGRESS_GATEWAY_HOST=0.0.0.0
INGRESS_GATEWAY_PORT=8000
INGRESS_GATEWAY_URL=https://executv.delegant.online
MCP_MOUNT_PATH=/mcp

# Browser origin after certbot. The UI and the proxied APIs share this host.
CORS_ORIGINS=https://executv.delegant.online,http://executv.delegant.online

MCP_BEARER_TOKEN=dev-executv-token
LLM_PROVIDER=seeded
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_TIMEOUT_SECONDS=8

SEED_EXECUTIVE_NAME=Avery Chen
SEED_EXECUTIVE_TITLE=Chief Executive Officer
SEED_FIRE_TV_DEVICE_NAME=Boardroom Fire TV
